/**
* Config.gs — 設定ファイル
*
* 導入時に編集するのは原則このファイルだけです。
* Slack の Webhook URL や LINE のトークンなど、公開したくない値は
* ここには書かず「スクリプト プロパティ」に登録してください（手順は README 参照）。
*
* スクリプト プロパティに登録するキー:
* SLACK_WEBHOOK_URL … Slack Incoming Webhook の URL（通知しない場合は空）
* LINE_CHANNEL_ACCESS_TOKEN … LINE Messaging API のチャネルアクセストークン（通知しない場合は空）
* LINE_TO_ID … LINE の送信先（ユーザーID または グループID）
*/

const CONFIG = {
// 整形した受付データを記録するシート名（なければ自動作成します）
LOG_SHEET_NAME: '受付ログ',

// 回答スプレッドシートのシート名。'' の場合は「フォームの回答」を含むシートを自動検出します
RESPONSE_SHEET_NAME: '',

// 申込者のメールアドレスが入っている列の見出し。
// '' の場合は「メール」「email」を含む見出しを自動検出します
EMAIL_COLUMN_HEADER: '',

// 自動返信メールの件名
REPLY_SUBJECT: 'お申し込みを受け付けました',

// 自動返信メールの送信者名（'' の場合は Google アカウントの既定名）
REPLY_FROM_NAME: '',

// 自動返信メールの本文テンプレート。
// {{列の見出し}} と書くと、その項目の回答に置き換わります。{{タイムスタンプ}} は受付日時です。
REPLY_BODY: [
'{{お名前}} 様',
'',
'お申し込みありがとうございます。以下の内容で受け付けました。',
'',
'--- お申し込み内容 ---',
'{{全項目}}',
'----------------------',
'受付日時: {{タイムスタンプ}}',
'',
'内容を確認のうえ、担当よりご連絡いたします。',
'このメールは自動送信されています。',
].join('\n'),

// 管理者への通知メールアドレス（'' の場合はメール通知しません。Slack / LINE と併用可）
ADMIN_EMAIL: '',

// 通知メッセージの先頭に付けるラベル
NOTIFY_TITLE: '新しいお申し込みがありました',
};

/** スクリプト プロパティから秘密情報を取得します（未登録なら ''） */
function getSecret_(key) {
return PropertiesService.getScriptProperties().getProperty(key) || '';
}
